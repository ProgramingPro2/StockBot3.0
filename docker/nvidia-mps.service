[Unit]
Description=NVIDIA CUDA Multi-Process Service (multi-user)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=forking
Environment=CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps
Environment=CUDA_MPS_LOG_DIRECTORY=/tmp/nvidia-mps-log
ExecStartPre=/bin/mkdir -p /tmp/nvidia-mps /tmp/nvidia-mps-log
ExecStartPre=/bin/chmod 1777 /tmp/nvidia-mps /tmp/nvidia-mps-log
ExecStart=/usr/bin/nvidia-cuda-mps-control -d -multiuser-server
ExecStop=/bin/bash -c 'echo quit | /usr/bin/nvidia-cuda-mps-control'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
