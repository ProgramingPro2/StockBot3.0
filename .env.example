# The Boardroom - Environment Template
# Copy to .env and adjust as needed.
# All data sources are FREE - no API keys required for yfinance.

# Trade tickers (comma-separated; default in config: SPY,IWM,XLE,XLF,EEM - chosen for active-trading fit)
# TRADE_TICKERS=SPY,IWM,XLE,XLF,EEM

# Ollama (local LLM for Narrative Specialist)
OLLAMA_URL=http://localhost:11434
# Best balance of speed + JSON/sentiment among common installs: qwen3:8b. Heavier but strong: gpt-oss:latest, qwen3:14b.
OLLAMA_MODEL=qwen3:8b
# Fallbacks tried if primary fails (comma-separated). Use models you have: ollama list
OLLAMA_FALLBACK_MODELS=gpt-oss:latest,llama3:latest,llama2:7b

# Top 3 NEW models to add for the Boardroom (pull with: ollama pull <name>):
#   1. qwen2.5:7b-instruct   - strong JSON/instruction following, fast
#   2. llama3.1:8b           - reliable instruction following, widely used
#   3. pilardi/sentiment-analysis - sentiment-specific, outputs sentiment/confidence/reasoning JSON

# Relative Strength Specialist: benchmark for outperformance score (default SPY)
# RELATIVE_STRENGTH_BENCHMARK=SPY

# Optional: override in config.py if needed
# CACHE_MAX_AGE_HOURS=1
# DEVICE=cuda (for specialists: TFT, VAE)
# PPO_DEVICE=cpu (recommended for PPO meta-learner; SB3 suggests CPU for MLP)
# PPO_CPU_THREADS=0 (0=use all cores; set to N to limit)

# Optional: fix PPO historical ratio for training and tuning (e.g. 0.2 = 20% historical). When set, tuning will not search this parameter.
# TRAIN_HISTORICAL_RATIO=0.2

# Alpaca API (for live trading mode)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Discord webhook (for trade notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

UNIVERSE_SOURCE=file
UNIVERSE_FILE=outputs/universe.txt

# Trading: fractional shares (yes/no) and starting capital for backtest/paper
# FRACTIONAL=yes  (use dollar notional orders; no = whole shares only)
# STARTING_CAPITAL=100000  (backtest/paper portfolio size in dollars)
FRACTIONAL=yes
STARTING_CAPITAL=100000