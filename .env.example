# The Boardroom - Environment Template
# Copy to .env and adjust as needed.
# All data sources are FREE - no API keys required for yfinance.

# Web UI (FastAPI). Default 28473 avoids clashes with common stacks on 8000/8080/3000.
# BOARDROOM_PORT=28473

# Trade tickers (comma-separated; default in config: SPY,IWM,XLE,XLF,EEM - chosen for active-trading fit)
# TRADE_TICKERS=SPY,IWM,XLE,XLF,EEM

# Ollama (local LLM for Narrative Specialist)
OLLAMA_URL=http://localhost:11434
# Best balance of speed + JSON/sentiment among common installs: qwen3:8b. Heavier but strong: gpt-oss:latest, qwen3:14b.
OLLAMA_MODEL=gemma4:latest
# Fallbacks tried if primary fails (comma-separated). Use models you have: ollama list
OLLAMA_FALLBACK_MODELS=gpt-oss:latest,llama3:latest,llama2:7b

# Top 3 NEW models to add for the Boardroom (pull with: ollama pull <name>):
#   1. qwen2.5:7b-instruct   - strong JSON/instruction following, fast
#   2. llama3.1:8b           - reliable instruction following, widely used
#   3. pilardi/sentiment-analysis - sentiment-specific, outputs sentiment/confidence/reasoning JSON

# Relative Strength Specialist: benchmark for outperformance score (default SPY)
# RELATIVE_STRENGTH_BENCHMARK=SPY

# Optional: override in config.py if needed
# CACHE_MAX_AGE_HOURS=1
# DEVICE=cuda (for specialists: TFT, VAE)
# PPO_DEVICE=cuda (default when unset; use PPO_DEVICE=cpu to force CPU for PPO)
# PPO_CPU_THREADS=0 (0=use all cores; set to N to limit)
# PPO_N_ENVS=16 (default caps at min(32, cpu_count); Subproc or batched vec env rollout width)
# PPO_USE_TORCH_VEC=1 (tune/train historical-only: single-process batched env on GPU/CPU)
# PPO_PARALLEL_TRIALS=1 (Optuna: concurrent worker processes on the same SQLite study)

# Optional: fix PPO historical ratio for training and tuning (e.g. 0.2 = 20% historical). When set, tuning will not search this parameter.
# TRAIN_HISTORICAL_RATIO=0.2

# Alpaca API (for live trading mode)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Discord webhook (for trade notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Boardroom summary: LLM one-sentence summary each paper/live cycle (default off). Set to 1/true/yes to enable.
# BOARDROOM_SUMMARY_ENABLED=1
# BOARDROOM_SUMMARY_DISCORD=1  (also send the summary to Discord when enabled)

# Paper/live only: normal run every 5 min (live data, cached sentiment/summary); Ollama sentiment + summary every 60 min.
# CYCLE_INTERVAL_MIN=5
# OLLAMA_INTERVAL_MIN=60
# Backtest/training: trading days between proxy-sentiment recomputes (no Ollama). Unset uses OLLAMA_INTERVAL_MIN // CYCLE_INTERVAL_MIN.
# BACKTEST_OLLAMA_EVERY_N_BARS=12

UNIVERSE_SOURCE=file
UNIVERSE_FILE=outputs/universe.txt

# --- Trading and execution ---
# Sizing uses total portfolio value (not cash) so targets stay stable and avoid sell-then-rebuy churn.
FRACTIONAL=yes
STARTING_CAPITAL=100000
# Minimum dollar gap to trigger a trade: max(MIN_TRADE_NOTIONAL, portfolio_value * REBALANCE_BAND_PCT)
# MIN_TRADE_NOTIONAL=100
# REBALANCE_BAND_PCT=0.03
# Live cooldowns (minutes): no sell within MIN_HOLD_MINUTES_AFTER_BUY of a buy; no buy within MIN_REENTRY_MINUTES_AFTER_SELL of a sell
# MIN_HOLD_MINUTES_AFTER_BUY=60
# MIN_REENTRY_MINUTES_AFTER_SELL=60
# Backtest and training: transaction cost and slippage in basis points (applied as drag on equity / reward)
# TRANSACTION_COST_BPS=10
# SLIPPAGE_BPS=5

# Pattern day trader (PDT) simulation: backtest, training envs, and live (optional)
# ENV_PDT_RESTRICTIONS=1
# PDT_MIN_ACCOUNT_EQUITY=25000   (restrictions apply when portfolio equity is below this)
# PDT_MAX_DAY_TRADES=3
# PDT_ROLLING_BUSINESS_DAYS=5

# --- Walk-forward evaluation ---
# Last TEST_WINDOW_DAYS are held out for out-of-sample backtest; tune and train use the rest.
# TEST_WINDOW_DAYS=252
# TRAIN_WINDOW_YEARS=5

# --- PPO training defaults ---
# TRAIN_HISTORICAL_RATIO=1.0  (1.0 = historical data only; 0 = synthetic only)

# --- Early stopping and regularization (reduce overfitting) ---
# PPO_EARLY_STOPPING_PATIENCE=5   (stop after this many evals with no improvement; 0 = disabled)
# PPO_EARLY_STOPPING_EVAL_FREQ=50000  (eval every N steps; 0 = no early stopping)
# PPO_EARLY_STOPPING_MIN_DELTA=0.01   (min reward increase to count as improvement)
# PPO_WEIGHT_DECAY=0   (L2 via Adam weight_decay; e.g. 1e-5 to reduce overfitting)

# --- Performance (see docs/perf-sprint.md) ---
# BENCH_TRACE=1
# PPO_USE_DUMMY_VEC=1
# PPO_TRAIN_USE_FULL_TUNED_N_STEPS=1
# PPO_TORCH_COMPILE=1
# TRAIN_SPECIALISTS_PARALLEL=1
# OPTUNA_PRUNER=median
# XGB_TREE_METHOD=hist
# XGB_DEVICE=cpu
# XGB_N_JOBS=0
# LIGHTGBM_N_JOBS=-1
# TFT_BATCH_SIZE=32
# TFT_DATALOADER_NUM_WORKERS=0
# TFT_DATALOADER_PERSISTENT=1
# TFT_MAX_EPOCHS=10
# TFT_PRECISION=16-mixed
# REGIME_VAE_BATCH_SIZE=64
# REGIME_VAE_EPOCHS=50